# Database - Local Development (Docker)
# DATABASE_URL="postgresql://postgres:postgres@localhost:55002/eventme?schema=public"

# Database - Neon (Production/Staging)
# Get from Neon Console → Connection → Connection string
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/eventme?sslmode=require"

# NextAuth (both formats for compatibility)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth (for Calendar integration)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Update redirect URI in Google Console to: https://your-app.vercel.app/api/auth/callback/google

# Resend (for email notifications)
RESEND_APIKEY="your-resend-api-key"

# Vercel Deployment (for Gitea CI)
VERCEL_ORG_ID="your-vercel-org-id"
VERCEL_PROJECT_ID="your-vercel-project-id"
# VERCEL_TOKEN is set as a secret in Gitea, not in this file
