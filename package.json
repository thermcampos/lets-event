    "prisma": "^7.10.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "resend": "^6.17.2",
